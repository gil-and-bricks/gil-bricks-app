# ---------------------------------------------------------------------------
# S1 — SECURITY HEADERS FOR EVERY STATIC PAGE.
#
# WHY THEY ARE STILL HERE NOW THAT PAGES RUN THE WORKER (DM1). `run_worker_first`
# is "/*" minus the static bulk, so every PAGE gets the Worker's own headers and
# this file no longer covers them. What it still covers is the excluded paths —
# /_astro, /map, /fonts, /brand and the named root files — which are served by
# the asset layer alone and would otherwise go out with no policy at all.
#
# KEEP THE TWO IN STEP, and a test now makes that literal: security.test.ts
# asserts the CSP string here is BYTE-IDENTICAL to the Worker's. It used to
# assert only that both named the same origins, which would not have noticed
# this file keeping the old r2.dev host after the Worker moved off it.
#
# The two that earn their place most: `frame-ancestors 'none'` stops the whole
# site being framed over an attacker's page (the account page's "Delete
# everything" is one irreversible click), and the Referrer-Policy stops the
# analyser's URL — postcode, house number, price, beds, every ticked refurb
# line — travelling to Rightmove, Zoopla and Google in the Referer header.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com https://data.proplaunch.ai https://pub-ed7263f454104eb1a02055393ee15800.r2.dev https://media.rightmove.co.uk https://*.zoocdn.com; font-src 'self' data:; connect-src 'self' https://data.police.uk https://environment.data.gov.uk https://www.planning.data.gov.uk https://landregistry.data.gov.uk https://data.proplaunch.ai https://pub-ed7263f454104eb1a02055393ee15800.r2.dev https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://www.youtube-nocookie.com https://www.youtube.com; worker-src 'self' blob:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Static-asset caching (C3). Cloudflare's default for Workers assets is
# `max-age=0, must-revalidate`, so every hashed chunk, glyph and sprite costs a
# round trip on every visit — measured on the map's own critical path.
#
# ONLY paths whose CONTENT CANNOT CHANGE UNDER A CACHED CLIENT are listed:
# /_astro/* is content-hashed by Astro, and the sprite folder is versioned (v4).
# /map/vendor/* is deliberately ABSENT — maplibre's worker file lives there at a
# stable path and must always match the library bundled beside it.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/map/sprites/v4/*
  Cache-Control: public, max-age=31536000, immutable

# Glyphs are regenerated only if we change font, which would be a deliberate act
# with a path change beside it. A month, so a mistake still heals by itself.
/map/fonts/*
  Cache-Control: public, max-age=2592000
