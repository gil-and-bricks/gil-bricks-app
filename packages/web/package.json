{
  "name": "@gil-bricks/web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/copy-map-worker.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "pipeline:download": "node pipeline/download.mjs",
    "pipeline:build": "node pipeline/build.mjs",
    "pipeline:upload": "node pipeline/upload.mjs",
    "typecheck": "tsc --noEmit",
    "smoke:comps": "tsx scripts/smoke-comps.ts",
    "smoke:valuation": "tsx scripts/smoke-valuation.ts",
    "db:migrate:local": "wrangler d1 migrations apply gil-bricks-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply gil-bricks-db --remote",
    "verify:map": "node scripts/verify-map-render.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.4",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@gil-bricks/core": "*",
    "@preact/signals": "^2.11.1",
    "@protomaps/basemaps": "^5.7.2",
    "astro": "^7.2.9",
    "maplibre-gl": "^6.6.0",
    "pmtiles": "^4.5.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "happy-dom": "^20.13.1",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "wrangler": "^4.127.1"
  }
}
