---
import AppShell from '../layouts/AppShell.astro';
import { dataFreshness, dataset, graph, SD_COPY } from '../config/structuredData';
import { AnalyserApp } from '../components/analyser/AnalyserApp';
import { siteConfig } from '../site.config';

const dataBase = () => siteConfig.dataBaseUrl.replace(/\/+$/, '');

/* S1 — read once at build time; invisible, non-fatal if the bucket is down. */
const freshness = await dataFreshness();
---

<AppShell
  title={`Sold comparables — ${siteConfig.siteName}`}
  description="The standard sales near a postcode, with honest £/m² evidence."
  jsonLd={graph([
    dataset({
      name: SD_COPY.compsName,
      description: SD_COPY.compsDescription,
      url: `${siteConfig.liveUrl.replace(/\/+$/, '')}/comparables/`,
      /* manifest.json is the single as-of source; this is that value read at
         build time, not a second one invented here. */
      asOf: freshness.modified,
      covers: freshness.covers,
      spatial: SD_COPY.spatial,
    }),
  ])}
>
  {/* This page runs the SAME comps engine the analysers do and needs the same
      two files on every search — start them at HTML parse, as they do (D5). */}
  <link rel="preload" as="fetch" href={`${dataBase()}/manifest.json`} crossorigin slot="head" />
  <link rel="preload" as="fetch" href={`${dataBase()}/sectors-index.json`} crossorigin slot="head" />
  <script is:inline define:vars={{ dataBaseUrl: dataBase() }} slot="head">
    (function warmPostcodeFile() {
      var pc = new URLSearchParams(location.search).get('postcode');
      if (!pc) return;
      var outcode = pc.trim().toUpperCase().replace(/\s+/g, ' ').split(' ')[0];
      if (!/^[A-Z]{1,2}[0-9][A-Z0-9]?$/.test(outcode)) return;
      var l = document.createElement('link');
      l.rel = 'preload'; l.as = 'fetch'; l.crossOrigin = 'anonymous';
      l.href = dataBaseUrl + '/postcodes/' + outcode + '.json';
      document.head.appendChild(l);
    })();
  </script>
  <h1 class="page-title">Sold comparables</h1>
  <p class="page-sub">Real Land Registry sales near any England &amp; Wales postcode.</p>
  <AnalyserApp client:load strategyName="Comparables" showVerdict={false} />
</AppShell>
