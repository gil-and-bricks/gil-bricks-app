---
import AppShell from '../layouts/AppShell.astro';
import { siteConfig } from '../site.config';
import { strategies } from '@gil-bricks/core';

const cards = [
  {
    href: '/area-data',
    title: 'Area Data',
    blurb: 'Sold prices, trend, activity and deprivation for any postcode.',
  },
  ...strategies.map((s) => ({
    href: `${s.route}/analyser`,
    title: s.name,
    blurb: s.tagline,
  })),
];
---

<AppShell title={`${siteConfig.siteName} — free England & Wales deal analyser`} description={siteConfig.tagline}>
  <section class="home-hero">
    <h1>{siteConfig.siteName}</h1>
    <p class="hero-maker">by {siteConfig.makerName}</p>
    <p class="tagline">{siteConfig.tagline}</p>
    <form class="home-search glass card" action="/area-data" method="get">
      <label for="home-pc">Start with a postcode</label>
      <div class="home-search-row">
        <input id="home-pc" name="pc" placeholder="e.g. CF37 1DL" autocomplete="postal-code" />
        <button type="submit" class="btn-primary">See area data</button>
      </div>
    </form>
  </section>

  <section class="tool-cards home-cards" aria-label="Tools">
    {cards.map((c) => (
      <a class="glass card" href={c.href}>
        <h2>{c.title}</h2>
        <p class="hint">{c.blurb}</p>
      </a>
    ))}
  </section>

  <section class="glass card home-chooser">
    <p><strong>Not sure which strategy?</strong> Take the 60-second chooser.</p>
    <a class="btn-secondary" href="/start">Point me at the right tool</a>
  </section>

  {/* Desktop-only: the extension is a Chrome side panel, so it's promoted to
      desktop visitors and hidden on phones (it isn't available there) — E11. */}
  <section class="glass card home-extension">
    <div>
      <p><strong>On a computer?</strong> Get the free Chrome side-panel extension to score any Rightmove or Zoopla listing as you browse.</p>
      <p class="hint">Chrome on desktop only — it isn’t available on phones.</p>
    </div>
    <a class="btn-secondary" href="/extension">See the extension</a>
  </section>

  <p class="home-trust">
    England &amp; Wales · Sold prices from HM Land Registry · Floor areas from EPC · Index from UK HPI · No asking prices, no scraping
  </p>
</AppShell>
