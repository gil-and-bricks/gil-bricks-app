---
/**
 * The homepage (D2). It SHOWS a Deal Score rather than describing one: the
 * example below is scored at build time by @gil-bricks/core — the same engine
 * the analyser runs — so the number here can never drift from the product.
 * Every word comes from src/config/home.ts.
 */
import AppShell from '../layouts/AppShell.astro';
import { siteConfig } from '../site.config';
import { analyseBtl, scoreDeal, strategies, fmtPct, type BtlInputs } from '@gil-bricks/core';
import { HOME } from '../config/home';
import { COPY } from '../config/copy';
import { features } from '../config/features';
import VideoSlot from '../components/site/VideoSlot.astro';

const store = siteConfig.chromeStoreUrl.trim();

// The worked example, from the strategy's OWN defaults so it stays honest if
// they are tuned. No maths here: the engine returns the score and the words.
const btl = strategies.find((s) => s.id === 'btl');
const def = (key: string): number => {
  const field = [...(btl?.strategyInputs ?? []), ...(btl?.assumptions ?? [])].find((f) => f.key === key);
  return Number(field?.default ?? 0);
};
const exampleInputs = {
  price: HOME.example.inputs.price,
  country: HOME.example.inputs.country,
  monthlyRent: HOME.example.inputs.monthlyRent,
  depositPct: def('deposit'),
  ratePct: def('rate'),
  buyingAs: 'basic',
  selfManaged: false,
  voidWeeks: def('voidWeeks'),
  agentPct: def('agentPct'),
  maintPct: def('maintPct'),
  insurancePerYear: def('insurance'),
  legals: def('legals'),
  refurb: def('refurbCost'),
  stressRatePct: def('stressRate'),
  taxBasis: 'additional',
  thresholds: (btl as unknown as { thresholds: Record<string, number> }).thresholds,
} as unknown as BtlInputs;
const analysis = analyseBtl(exampleInputs);
// A1 — the page may only show a Deal Score while the product produces one. Every
// analyser island already guards scoreDeal this way; the homepage was the last
// surface promising a score the flag can switch off. The worked example itself
// survives: analyseBtl does not depend on the flag, so the ROI and the yield
// still come from the engine.
const deal = features.dealScore ? scoreDeal('btl', exampleInputs) : null;
const tier = deal === null ? '' : deal.verdict === 'good' ? 'ds-good' : deal.verdict === 'marginal' ? 'ds-marginal' : 'ds-walk';
---

<AppShell title={`${siteConfig.siteName} — free England & Wales deal analyser`} description={HOME.lead}>
  {/* H1 — the page leads with WHAT IT DOES. The name and the maker were here
      twice: once in the header, then again as the h1 and a line under it. A
      stranger from a YouTube comment has ten seconds and does not need to be
      told our name twice before being told what this is. */}
  <section class="home-hero">
    <h1>{HOME.lead}</h1>
    <p class="home-sub">{features.dealScore ? HOME.sub : HOME.noScore.sub}</p>
    <p class="home-hero-cta">
      <a class="btn-primary" href="/buy-to-let/analyser">{HOME.heroCta}</a>
    </p>
    <p class="home-hero-note">{HOME.heroCtaNote}</p>
  </section>

  {/* The product doing its job, not a description of it. */}
  <section class="glass card home-example" aria-labelledby="home-example-h">
    <h2 id="home-example-h">{HOME.example.heading}</h2>
    <p class="hint">{HOME.example.subject}</p>
    {deal && (
      <div class={`deal-score ${tier}`}>
        <span class="ds-score"><strong>{deal.score.toFixed(1)}</strong><span class="ds-outof">{HOME.example.outOf}</span></span>
        <span class="ds-verdict">{deal.verdict}</span>
        <span class="ds-headline">{deal.headline}</span>
      </div>
    )}
    <dl class="tool-figures home-figures">
      <div><dt>{HOME.example.labels.roi}</dt><dd>{fmtPct(analysis.roi.value)}</dd></div>
      <div><dt>{HOME.example.labels.yield}</dt><dd>{fmtPct(analysis.grossYield.value)}</dd></div>
    </dl>
    <p class="hint">{HOME.example.note}</p>
    <p><a class="btn-primary" href="/buy-to-let/analyser">{HOME.example.cta}</a></p>
  </section>

  <section class="home-does" aria-labelledby="home-does-h">
    <h2 id="home-does-h">{HOME.does.heading}</h2>
    <ul class="tool-list">
      {HOME.does.items.map((item) => (
        <li class="glass card tool-card">
          <h3>{
            !features.dealScore && item.id === 'scores' ? HOME.noScore.doesTitle
              : !features.dealPipeline && item.id === 'pipeline' ? HOME.noPipeline.doesTitle
                : item.title
          }</h3>
          <p class="hint">{!features.dealPipeline && item.id === 'pipeline' ? HOME.noPipeline.doesBody : item.body}</p>
        </li>
      ))}
    </ul>
  </section>

  {/* H1 — ONE grouping, so "Ways in" actually groups them. It was a heading
      followed by four sibling h2s, which announces four unrelated sections. */}
  <section class="home-ways" aria-labelledby="home-ways-h">
  <h2 class="home-ways-h" id="home-ways-h">{HOME.waysIn.heading}</h2>

  {/* The extension is published, so it is promoted, not buried — and it is the
      way in that fits somebody already looking at a listing. */}
  <section class="glass card home-extension" aria-labelledby="home-ext-h">
    <div>
      <h3 id="home-ext-h">{HOME.extension.heading}</h3>
      <p>{HOME.extension.body}</p>
      <p class="hint">{HOME.extension.note}</p>
    </div>
    <div class="home-extension-cta">
      {store !== '' && (
        <a class="store-badge" href={store} target="_blank" rel="noopener noreferrer">
          <img src="/brand/chrome-web-store-badge.png" alt={COPY.extension.badgeAlt} width="206" height="58" />
        </a>
      )}
      <a class="btn-secondary" href="/extension">{HOME.extension.more}</a>
    </div>
  </section>

  <section class="home-strategies" aria-labelledby="home-strat-h">
    <h3 id="home-strat-h">{HOME.strategies.heading}</h3>
    <ul class="tool-list home-strategy-list">
      {strategies.map((s) => (
        <li class="glass card tool-card">
          {/* h4, because "Pick a strategy" above them is an h3 inside the Ways
              in group. Demoting the group headings and leaving the cards where
              they were made the cards siblings of the heading meant to group
              them, which flattens the outline a screen reader reads. */}
          <h4><a href={`${s.route}/analyser`}>{s.name}</a></h4>
          <p class="hint">{s.tagline}</p>
        </li>
      ))}
    </ul>
    <p class="home-chooser-line">{HOME.chooser.body} <a href="/start">{HOME.chooser.cta}</a></p>
  </section>

  <section class="glass card home-area" aria-labelledby="home-area-h">
    <h3 id="home-area-h">{HOME.search.heading}</h3>
    <form class="home-search" action="/area-data" method="get">
      <label for="home-pc">{HOME.search.label}</label>
      <div class="home-search-row">
        <input id="home-pc" name="pc" required placeholder={HOME.search.placeholder} autocomplete="postal-code" />
        <button type="submit" class="btn-secondary">{HOME.search.submit}</button>
      </div>
    </form>
  </section>

  {features.toolsSection && (
    <section class="glass card home-tools" aria-labelledby="home-tools-h">
      <h3 id="home-tools-h">{HOME.tools.heading}</h3>
      <p>{HOME.tools.body}</p>
      <p><a class="btn-secondary" href="/tools">{HOME.tools.cta}</a></p>
    </section>
  )}

  </section>

  {features.homeVideo && (
    <VideoSlot
      ready={HOME.video.url.trim() !== ''}
      url={HOME.video.url}
      heading={HOME.video.heading}
      placeholder={HOME.video.placeholder}
      load={HOME.video.load}
      note={HOME.video.note}
    />
  )}

  {/* H1 — the operator writes this himself (HOME.whyFree.body). Until he does
      it says so, rather than the page inventing a reason he never gave. */}
  {features.homeWhyFree && (
    <section class="glass card home-why" aria-labelledby="home-why-h">
      <h2 id="home-why-h">{HOME.whyFree.heading}</h2>
      {HOME.whyFree.body.trim() === ''
        ? <p class="hint home-why-placeholder">{HOME.whyFree.placeholder}</p>
        : <p>{HOME.whyFree.body}</p>}
    </section>
  )}

  <p class="home-trust">{HOME.trust}</p>
</AppShell>
