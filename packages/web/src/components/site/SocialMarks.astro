---
/**
 * The official Instagram and YouTube marks, ONE copy for header and footer (H1)
 * — and, since X1, one copy shared with the EXTENSION as well.
 *
 * THE GEOMETRY NO LONGER LIVES HERE. Both marks are described once, in
 * `@gil-bricks/core` (`src/brand/socialMarks.ts`), because the extension's side
 * panel draws the same two marks and used to do it with its own hand-traced
 * monochrome path — which neither company's guidelines permit. This component
 * is now a renderer: it asks core for the shapes and paints them.
 *
 * What stays here is what is genuinely presentational: where they sit, how big
 * they are at each breakpoint, and the header's measured hide rule. The sizes
 * come from core too (they were measured by counting painted pixels, and the
 * extension needs the same numbers), so this stylesheet reads them rather than
 * restating them.
 *
 * Neither mark is recoloured and neither is fetched: inline SVG, self-hosted,
 * no CDN, no request.
 */
import { socialMark, SOCIAL_MARK_SIZES } from '@gil-bricks/core';
import { siteConfig } from '../../site.config';
import { NAV } from '../../config/nav';

interface Props {
  /** Where these sit, so the two places can differ in size without forking. */
  place: 'header' | 'footer';
}
const { place } = Astro.props;

// The gradient ids are namespaced by place: header and footer both render
// Instagram, and two identical ids on one page would make the second mark
// reference the first one's gradient.
const ig = socialMark('instagram', place);
const yt = socialMark('youtube', place);
const size = SOCIAL_MARK_SIZES[place];
---

<div class:list={['social-marks', `social-marks-${place}`]}>
  <a
    href={siteConfig.socials.instagram}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={NAV.socials.instagram.label(siteConfig.makerName)}
    title={NAV.socials.instagram.title}
  >
    <svg
      viewBox={ig.viewBox}
      class="mark mark-ig"
      aria-hidden="true"
      focusable="false"
      style={`width:${size.instagram.w}px;height:${size.instagram.h}px`}
    >
      <defs>
        {ig.gradients.map((g) => (
          <radialGradient id={g.id} cx={g.cx} cy={g.cy} r={g.r}>
            {g.stops.map((s) => (
              <stop offset={s.offset} stop-color={s.color} stop-opacity={s.opacity} />
            ))}
          </radialGradient>
        ))}
      </defs>
      {ig.shapes.map((s) => (s.tag === 'rect' ? <rect {...s.attrs} /> : <path {...s.attrs} />))}
    </svg>
  </a>
  <a
    href={siteConfig.socials.youtube}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={NAV.socials.youtube.label(siteConfig.makerName)}
    title={NAV.socials.youtube.title}
  >
    <svg
      viewBox={yt.viewBox}
      class="mark mark-yt"
      aria-hidden="true"
      focusable="false"
      style={`width:${size.youtube.w}px;height:${size.youtube.h}px`}
    >
      {yt.shapes.map((s) => (s.tag === 'rect' ? <rect {...s.attrs} /> : <path {...s.attrs} />))}
    </svg>
  </a>
</div>

<style>
  .social-marks { display: flex; align-items: center; gap: var(--space-3); }
  .social-marks a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* A comfortable hit area around a quiet mark — the target is 44px, the
       ink is not. */
    min-width: 2.75rem;
    min-height: 2.75rem;
    border-radius: 10px;
    /* They are a credit, not a call to action: full colour at 0.85, and no lime
       chrome of ours painted around somebody else's mark. */
    opacity: 0.85;
    transition: opacity 120ms ease;
  }
  .social-marks a:hover, .social-marks a:focus-visible { opacity: 1; }
  /* The sizes themselves are inline, read from core — see the note above. They
     are matched by GEOMETRIC MEAN, not by height or width: Instagram is 1:1 and
     YouTube is 24:16.2, so equal boxes are never equal marks. */
  .mark { display: block; }
  /* THE HEADER SHOWS THEM ONLY WHERE ITS ROW ACTUALLY FITS THEM. Measured by
     sweeping 300-1000px in 10px steps and reading the header's own height:
       under 330px — no room beside the wordmark (the row wrapped, +43px, and
                     CLS went to 0.129 against a 0.002 baseline)
       330-640px  — the nav is hidden here and the tab bar has it, so there is
                     room to spare: the marks show at 390px and at 360px
       641-860px  — the full nav is back and the row wraps to two on EVERY page,
                     76px to 128px. This is the whole tablet-portrait range
                     (iPad mini 744, iPad 768/810, iPad Air 820, iPad Pro 834)
                     and the first cut of H1 broke it by deleting the old
                     blanket hide after measuring only 320, 390 and 1280.
       861px+     — fits.
     The footer carries them at every width, so nothing is ever unreachable. */
  @media (max-width: 329px), (min-width: 641px) and (max-width: 860px) {
    .social-marks-header { display: none; }
  }
</style>
