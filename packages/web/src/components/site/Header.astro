---
import { siteConfig } from '../../site.config';
import { strategies } from '@gil-bricks/core';
import { AuthHeader } from '../auth/AuthHeader';
import { features } from '../../config/features';
import { NAV } from '../../config/nav';
---

<header class="site-header">
  <a class="brand" href="/" aria-label={`${siteConfig.siteName} by ${siteConfig.makerName} — home`}>
    <img class="brand-logo" src="/brand/proplaunch-wordmark.png" alt={siteConfig.siteName} width="152" height="38" decoding="async" />
    <span class="brand-maker">by {siteConfig.makerName}</span>
  </a>
  {features.navV2 ? (
    <nav aria-label={NAV.mainLabel} class="nav-v2">
      {/* The four strategies live inside one grouping so Tools and Finance have
          somewhere to go. On the analyser they are never buried: the segmented
          switcher keeps all four one tap away (N3). Native <details>, no JS. */}
      <details class="nav-group">
        <summary title={NAV.analyse.hint}>{NAV.analyse.label}</summary>
        <ul>
          {strategies.map((s) => <li><a href={`${s.route}/analyser`}>{s.name}</a></li>)}
        </ul>
      </details>
      {NAV.primary.map((l) => <a href={l.href}>{l.label}</a>)}
      <span class="nav-mine">
        {NAV.mine.map((l) => <a href={l.href}>{l.label}</a>)}
      </span>
    </nav>
  ) : (
    <nav aria-label="Main">
      <a href="/area-data">Area Data</a>
      {strategies.map((s) => <a href={`${s.route}/analyser`}>{s.shortName ?? s.name}</a>)}
    </nav>
  )}
  <div class="header-right">
    <div class="header-socials">
      <a href={siteConfig.socials.instagram} target="_blank" rel="noopener noreferrer"
         aria-label={`${siteConfig.makerName} on Instagram (opens a new tab)`} title="Instagram">
        <svg viewBox="0 0 24 24" class="social-icon" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.22 1 .48 1.4.9.42.4.68.8.9 1.4.17.4.37 1 .42 2.2.06 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.05 1.2-.25 1.8-.42 2.2-.22.6-.48 1-.9 1.4-.4.42-.8.68-1.4.9-.4.17-1 .37-2.2.42-1.3.06-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.05-1.8-.25-2.2-.42-.6-.22-1-.48-1.4-.9-.42-.4-.68-.8-.9-1.4-.17-.4-.37-1-.42-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.05-1.2.25-1.8.42-2.2.22-.6.48-1 .9-1.4.4-.42.8-.68 1.4-.9.4-.17 1-.37 2.2-.42C8.4 2.2 8.8 2.2 12 2.2Zm0 3.2A6.6 6.6 0 1 0 18.6 12 6.6 6.6 0 0 0 12 5.4Zm0 10.9A4.3 4.3 0 1 1 16.3 12 4.3 4.3 0 0 1 12 16.3Zm6.9-11.1a1.54 1.54 0 1 1-1.55-1.54 1.54 1.54 0 0 1 1.55 1.54Z"/></svg>
      </a>
      <a href={siteConfig.socials.youtube} target="_blank" rel="noopener noreferrer"
         aria-label={`${siteConfig.makerName} on YouTube (opens a new tab)`} title="YouTube">
        <svg viewBox="0 0 24 24" class="social-icon" aria-hidden="true" focusable="false"><path fill="currentColor" d="M23.5 6.5a3 3 0 0 0-2.1-2.1C19.5 3.9 12 3.9 12 3.9s-7.5 0-9.4.5A3 3 0 0 0 .5 6.5 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.5 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.5ZM9.6 15.6V8.4l6.2 3.6Z"/></svg>
      </a>
    </div>
    <AuthHeader client:idle />
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* the grouped nav (N4) is wider than the old flat list: let the row wrap
       rather than push the page sideways on a small tablet */
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    max-width: 72rem;
    margin: 0 auto;
  }
  .brand {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
    text-decoration: none;
  }
  .brand-logo {
    height: 38px;
    width: auto;
    display: block;
  }
  .brand-maker {
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    min-width: 0;
    gap: var(--space-4);
    align-items: center;
  }
  /* Between the phone bar (<=640px) and a comfortable desktop, the nav gives up
     its gaps before anything is pushed off-screen. */
  @media (max-width: 820px) {
    .site-header { gap: var(--space-2); padding-left: var(--space-3); padding-right: var(--space-3); }
    nav { gap: var(--space-3); }
    .nav-mine { margin-left: var(--space-2); padding-left: var(--space-2); gap: var(--space-3); }
    .header-socials { display: none; }  /* both socials are one tap away in the footer's own links */
  }
  /* The Analyse grouping: a native disclosure, so it needs no JavaScript and
     the browser gives it the button semantics and keyboard behaviour. */
  .nav-group { position: relative; }
  .nav-group > summary {
    list-style: none; cursor: pointer; color: var(--text-dim);
    font-size: var(--text-sm); display: inline-flex; align-items: center; gap: 4px;
    min-height: 2.75rem;
  }
  .nav-group > summary::-webkit-details-marker { display: none; }
  .nav-group > summary::after { content: '▾' / ''; color: var(--accent); }
  .nav-group[open] > summary { color: var(--accent); }
  .nav-group > ul {
    position: absolute; top: 100%; left: 0; z-index: 40;
    margin: var(--space-2) 0 0; padding: var(--space-2);
    list-style: none; min-width: 12rem;
    background: var(--glass-bg-fallback);
    border: 1px solid var(--glass-border); border-radius: 12px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
  }
  .nav-group > ul a { display: block; padding: var(--space-2) var(--space-3); border-radius: 8px; }
  .nav-group > ul a:hover { background: rgba(220, 255, 0, 0.08); }
  .nav-mine { display: inline-flex; gap: var(--space-4); margin-left: var(--space-4); padding-left: var(--space-4); border-left: 1px solid var(--glass-border); }
  nav a {
    color: var(--text-dim);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  nav a:hover {
    color: var(--accent);
  }
  .header-right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .header-socials {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }
  .header-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    color: var(--accent);
    border: 1px solid transparent;
  }
  .header-socials a:hover {
    border-color: var(--accent);
    background: rgba(220, 255, 0, 0.08);
  }
  .social-icon {
    width: 1.25rem;
    height: 1.25rem;
    display: block;
  }
  @media (max-width: 640px) {
    nav { display: none; } /* the bottom tab bar takes over */
  }
  /* A 320px phone (iPhone SE, and anyone at 400% zoom) must never scroll
     sideways: the header's own row was 18px wider than the screen. Nothing is
     dropped — the wordmark and the gaps give up the pixels. */
  @media (max-width: 400px) {
    .site-header { gap: var(--space-2); padding: var(--space-3) var(--space-3); }
    .brand-logo { height: 30px; }
    .brand-maker { font-size: 0.55rem; }
    .header-right { gap: var(--space-2); }
    .header-socials { gap: 0; }
    .header-socials a { width: 1.75rem; height: 1.75rem; }
  }
</style>
