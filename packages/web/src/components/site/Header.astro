---
import { siteConfig } from '../../site.config';
import { strategies } from '@gil-bricks/core';
import { AuthHeader } from '../auth/AuthHeader';
import { features } from '../../config/features';
import { NAV, primaryLinks, desktopMoreLinks } from '../../config/nav';
import SocialMarks from './SocialMarks.astro';
---

<header class="site-header">
  <a class="brand" href="/" aria-label={NAV.brand.label(siteConfig.siteName, siteConfig.makerName)}>
    <img class="brand-logo" src="/brand/proplaunch-wordmark.png" alt={siteConfig.siteName} width="804" height="100" decoding="async" />
    <span class="brand-maker">{NAV.brand.by} {siteConfig.makerName}</span>
  </a>
  {features.navV2 ? (
    <nav aria-label={NAV.mainLabel} class="nav-v2">
      {/* The four strategies live inside one grouping so Tools and Finance have
          somewhere to go. On the analyser they are never buried: the segmented
          switcher keeps all four one tap away (N3). Native <details>, no JS. */}
      <details class="nav-group">
        <summary title={NAV.analyse.hint}>{NAV.analyse.label}</summary>
        <ul>
          {strategies.map((s) => <li><a href={`${s.route}/analyser`}>{s.name}</a></li>)}
        </ul>
      </details>
      {primaryLinks().map((l) => <a href={l.href}>{l.label}</a>)}
      {/* A1 — the desktop route to the More-sheet pages. The bottom bar only
          exists under 640px, so above that /comparables and /credit had no link
          anywhere. Same list as the phone sheet (desktopMoreLinks), same native
          <details>, so the two can never drift apart. */}
      {features.desktopMore && desktopMoreLinks().length > 0 && (
        <details class="nav-group nav-more">
          <summary aria-label={NAV.more.hint}>{NAV.more.label}</summary>
          <ul>
            {desktopMoreLinks().map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </details>
      )}
      <span class="nav-mine">
        {NAV.mine.map((l) => <a href={l.href}>{l.label}</a>)}
      </span>
    </nav>
  ) : (
    <nav aria-label={NAV.mainLabel}>
      <a href={NAV.areaData.href}>{NAV.areaData.label}</a>
      {strategies.map((s) => <a href={`${s.route}/analyser`}>{s.shortName ?? s.name}</a>)}
    </nav>
  )}
  <div class="header-right">
    <SocialMarks place="header" />
    <AuthHeader client:idle />
  </div>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* the grouped nav (N4) is wider than the old flat list: let the row wrap
       rather than push the page sideways on a small tablet */
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    max-width: 72rem;
    margin: 0 auto;
  }
  /* C2 — THE WORDMARK AND THE CREDIT SHARE A LEFT EDGE.
     They always had `align-items: flex-start`, so the BOXES agreed; the artwork
     did not. The PNG was 900x225 with 50px of transparent padding down its left
     side, so at the old 38px render height the glyph began 8.4px inside its own
     box while the credit began at 0 — a visible step, and not fixable by nudging
     because the offset scales with the render height. The asset is now cropped
     to its glyph (804x100), so the box IS the mark and flex-start is true.
     The old box was also 38px tall around a 17px glyph, which made the vertical
     gap accidental; the mark now renders at its real 17px and the gap is a
     spacing token chosen on purpose. */
  .brand {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    text-decoration: none;
  }
  .brand-logo {
    height: 17px;
    width: auto;
    display: block;
  }
  .brand-maker {
    font-size: var(--text-2xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    min-width: 0;
    gap: var(--space-4);
    align-items: center;
  }
  /* Between the phone bar (<=640px) and a comfortable desktop, the nav gives up
     its gaps before anything is pushed off-screen. */
  @media (max-width: 960px) {
    .site-header { gap: var(--space-2); padding-left: var(--space-3); padding-right: var(--space-3); }
    nav { gap: var(--space-3); }
    .nav-mine { margin-left: var(--space-2); padding-left: var(--space-2); gap: var(--space-3); }
    /* The marks decide their own widths — SocialMarks.astro owns that, because
       it owns the class. The old blanket hide below 960px lived here and was
       too broad; the replacement is banded and measured. */
  }
  /* The Analyse grouping: a native disclosure, so it needs no JavaScript and
     the browser gives it the button semantics and keyboard behaviour. */
  .nav-group { position: relative; }
  .nav-group > summary {
    list-style: none; cursor: pointer; color: var(--text-dim);
    font-size: var(--text-sm); display: inline-flex; align-items: center; gap: 4px;
    min-height: 2.75rem;
  }
  .nav-group > summary::-webkit-details-marker { display: none; }
  .nav-group > summary::after { content: '▾' / ''; color: var(--accent); }
  .nav-group[open] > summary { color: var(--accent); }
  .nav-group > ul {
    position: absolute; top: 100%; left: 0; z-index: 40;
    margin: var(--space-2) 0 0; padding: var(--space-2);
    list-style: none; min-width: 12rem;
    /* A menu is an overlay, not a glass card: opaque so the page behind it
       cannot be read through the links (D1). */
    background: var(--bg-1);
    border: 1px solid var(--glass-border); border-radius: 12px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
  }
  .nav-group > ul a { display: block; padding: var(--space-2) var(--space-3); border-radius: 8px; }
  .nav-group > ul a:hover { background: rgba(220, 255, 0, 0.08); }
  /* The More sits further right than Analyse, so its panel hangs from the right
     edge — anchored left it would push past the viewport on a narrow laptop. */
  .nav-more > ul { left: auto; right: 0; }
  .nav-mine { display: inline-flex; gap: var(--space-4); margin-left: var(--space-4); padding-left: var(--space-4); border-left: 1px solid var(--glass-border); }
  nav a {
    color: var(--text-dim);
    text-decoration: none;
    font-size: var(--text-sm);
  }
  nav a:hover {
    color: var(--accent);
  }
  .header-right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    /* RESERVE THE SIGNED-IN CONTROL'S HEIGHT (C2). AuthHeader is client:idle,
       so it arrives after first paint. It used to be invisible in the layout
       because the taller brand block set the header's height; cropping the
       wordmark made the brand shorter, so the island's arrival started moving
       the whole page — CLS went 0 → 0.011. Reserving its row keeps the header a
       fixed height from the first frame, whatever hydrates into it. */
    min-height: 2.75rem;
  }
  /* The marks live entirely in SocialMarks.astro — ONE copy for header and
     footer, so the two can never drift apart again (H1). Nothing about them is
     styled from here: a `:global(.social-marks-header)` rule written here loses
     on specificity to the component's own scoped rule and is simply dead. */
  @media (max-width: 640px) {
    nav { display: none; } /* the bottom tab bar takes over */
  }
  /* A 320px phone (iPhone SE, and anyone at 400% zoom) must never scroll
     sideways: the header's own row was 18px wider than the screen. Nothing is
     dropped — the wordmark and the gaps give up the pixels. */
  @media (max-width: 400px) {
    .site-header { gap: var(--space-2); padding: var(--space-3) var(--space-3); }
    /* Same optical size as before the crop: the old 30px BOX held a 13px mark. */
    .brand-logo { height: 13px; }
    .brand-maker { font-size: var(--text-2xs); }
    .header-right { gap: var(--space-2); }
    /* nothing: the marks are already out of the header at this width */
  }
</style>

<script is:inline>
  {
    // Every header disclosure — the Analyse menu and the More menu (A1) — is a
    // native <details>. Two things the browser does not give free: opening one
    // must close the other (or the keyboard leaves both open, overlapping), and
    // Escape must close the OPEN one and put focus back on its own summary.
    const groups = Array.from(document.querySelectorAll('.nav-group'));
    for (const group of groups) {
      group.addEventListener('toggle', () => {
        if (!group.open) return;
        for (const other of groups) if (other !== group) other.open = false;
      });
    }
    document.addEventListener('pointerdown', (e) => {
      for (const group of groups) {
        if (group.open && !group.contains(e.target)) group.open = false;
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = groups.find((g) => g.open);
      if (!open) return;
      open.open = false;
      open.querySelector('summary').focus();
    });
  }
</script>
