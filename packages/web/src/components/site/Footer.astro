---
import { OGL_ATTRIBUTION } from '@gil-bricks/core';
import { siteConfig } from '../../site.config';
import { FOOTER } from '../../config/nav';
import { DATA_FRESHNESS } from '../../config/freshness';
import { features } from '../../config/features';
import SocialMarks from './SocialMarks.astro';
---

<footer class="site-footer">
  {/* H1 — one centred column, in the order somebody reads it: who made it,
      where to find him, the legal pages, then the attributions we are required
      to print. It was a left-aligned list of leftovers against a 72rem rule. */}
  <p class="footer-maker">
    <span>{siteConfig.siteName} {FOOTER.madeBy}</span>
    <img src="/brand/gil-and-bricks-wordmark.png" alt={siteConfig.makerName} width="499" height="218" decoding="async" loading="lazy" />
  </p>

  <p class="footer-contact">{FOOTER.contactLead}</p>
  <SocialMarks place="footer" />

  <nav class="footer-links" aria-label={FOOTER.linksLabel}>
    <a href="/terms">{FOOTER.terms}</a>
    <a href="/privacy">{FOOTER.privacy}</a>
  </nav>

  {/* The attributions are legally required and long. They are not hidden — they
      get their own quiet place below a rule, so the footer reads as a designed
      object instead of trailing off into small print. */}
  <div class="footer-legal">
    <p>{OGL_ATTRIBUTION}</p>
    <p>{FOOTER.dataLicences}</p>
    <p>
      <span data-asof-line>{FOOTER.asOfBefore}<span data-asof></span>{FOOTER.asOfAfter}</span>
      {features.staleDataNote && <span class="asof-stale" data-stale-note hidden>{' '}{DATA_FRESHNESS.note}</span>}
    </p>
  </div>
</footer>

<script>
  import { getManifest, dataFreshness } from '@gil-bricks/core';
  import { DATA_FRESHNESS } from '../../config/freshness';
  import { features } from '../../config/features';
  // Only ever shown once a REAL as-of date is in hand — a dash where a date
  // belongs reads as broken, and if the manifest can't be reached we would be
  // printing it for ever (D3). It is hidden with VISIBILITY, not `hidden`, so
  // the line holds its own space from the first paint and revealing it moves
  // nothing (D5).
  getManifest()
    .then((m) => {
      const el = document.querySelector('[data-asof]');
      const line = document.querySelector('[data-asof-line]');
      if (!el || !line || !m.ppdMonth) return;
      el.textContent = m.ppdMonth;
      (line as HTMLElement).dataset.asofLine = 'ready';
      // THE DATE ALONE IS NOT ENOUGH. When the monthly refresh stops, this line
      // keeps printing a true but frozen month and looks identical to a fresh
      // one. The age is judged in @gil-bricks/core against a threshold in
      // config; this only reveals a sentence that is already on the page.
      if (!features.staleDataNote) return;
      const note = document.querySelector('[data-stale-note]');
      if (note !== null && dataFreshness(m.generatedAt, Date.now(), DATA_FRESHNESS.staleAfterDays).stale) {
        (note as HTMLElement).hidden = false;
      }
    })
    .catch(() => {});
</script>

<style>
  .footer-contact { margin: 0; }
  .footer-links { display: flex; justify-content: center; gap: var(--space-4); margin: 0; }
  .footer-links a { color: var(--accent); }
  /* The required attributions: their own place, below a rule, quieter than the
     rest — printed in full, but not the loudest thing down here. */
  .footer-legal {
    margin: var(--space-4) auto 0;
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    max-width: 46rem;
    font-size: var(--text-2xs);
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.5;
  }
  .footer-legal p { margin: 0 0 var(--space-2); }
  .footer-legal p:last-child { margin-bottom: 0; }
  /* D5 — the as-of line holds its space from the first paint and is revealed in
     place, so the footer never grows under the page. */
  /* The month itself is the only part that arrives late; holding its width in
     CSS keeps the line from reflowing when it lands. */
  [data-asof-line] { visibility: hidden; }
  [data-asof] { display: inline-block; min-width: 4.5em; }
  [data-asof-line='ready'] { visibility: visible; }
  /* Not dimmed like the rest of the footer: it is the one line here that is
     telling you something is wrong. It is the LAST thing in the footer, so
     revealing it pushes nothing down (no layout shift). */
  .asof-stale { color: var(--text); }
  .site-footer {
    max-width: 72rem;
    margin: var(--space-8) auto 0;
    padding: var(--space-6) var(--space-5) calc(var(--space-8) + 3rem);
    color: var(--text-dim);
    font-size: var(--text-xs);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    /* ONE centred column. The maker credit was left-aligned against a 72rem
       rule and looked stranded (H1). */
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }
  .footer-maker {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
  }
  /* C2 — the asset was cropped to its glyph, so the same optical size is now a
     smaller number. The old CSS height was 44px on a 520x293 asset whose glyph
     was 218 tall, so the mark rendered at 218/293 x 44 = 32.74px. (The tag's
     width/height attributes said 88x50 and were simply wrong about the file;
     deriving from THEM first made this 13% too big.) */
  .footer-maker img { height: 33px; width: auto; display: block; }
</style>
