---
import { OGL_ATTRIBUTION } from '@gil-bricks/core';
import { siteConfig } from '../../site.config';
---

<footer class="site-footer">
  <p class="footer-maker">
    <span>{siteConfig.siteName} is made by</span>
    <img src="/brand/gil-and-bricks-wordmark.png" alt={siteConfig.makerName} width="88" height="50" decoding="async" loading="lazy" />
  </p>
  <p>{OGL_ATTRIBUTION}</p>
  <p>
    Contains OS, Royal Mail and National Statistics data per the ONSPD licence.
    Deprivation: English Indices of Deprivation 2025 (MHCLG) and Welsh Index of
    Multiple Deprivation 2025 (Welsh Government), Open Government Licence v3.0.
    Sold-price data as of <span data-asof>—</span>.
  </p>
</footer>

<script>
  import { getManifest } from '@gil-bricks/core';
  getManifest()
    .then((m) => {
      const el = document.querySelector('[data-asof]');
      if (el) el.textContent = m.ppdMonth;
    })
    .catch(() => {});
</script>

<style>
  .site-footer {
    max-width: 72rem;
    margin: var(--space-8) auto 0;
    padding: var(--space-5) var(--space-5) calc(var(--space-8) + 3rem);
    color: var(--text-dim);
    font-size: var(--text-xs);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer-maker {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
  }
  .footer-maker img { height: 44px; width: auto; display: block; }
</style>
