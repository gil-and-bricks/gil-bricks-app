---
/**
 * Section heading primitive — Montserrat display face.
 * `as` picks the heading level (default h2); content comes from the slot.
 */
interface Props {
  as?: 'h1' | 'h2' | 'h3' | 'h4';
  class?: string;
}
const { as: Tag = 'h2', class: className = '' } = Astro.props;
---

<Tag class:list={['section-heading', className]}>
  <slot />
</Tag>

<style>
  .section-heading {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    line-height: 1.2;
  }
</style>
