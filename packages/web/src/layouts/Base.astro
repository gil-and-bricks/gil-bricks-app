---
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/montserrat/latin-800.css';
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { siteConfig } from '../site.config';
// Above-the-fold faces, preloaded so the font-display:swap repaint happens
// early instead of re-anchoring LCP seconds later on slow connections.
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import montserrat700 from '@fontsource/montserrat/files/montserrat-latin-700-normal.woff2?url';
import montserrat800 from '@fontsource/montserrat/files/montserrat-latin-800-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = siteConfig.siteName,
  description = siteConfig.tagline,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href={siteConfig.dataBaseUrl} crossorigin />
    <link rel="preconnect" href="https://landregistry.data.gov.uk" crossorigin />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="font" type="font/woff2" href={poppins400} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={montserrat700} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={montserrat800} crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
