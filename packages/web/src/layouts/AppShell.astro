---
import Base from './Base.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import TabBar from '../components/site/TabBar.astro';
import { LoginWall } from '../components/auth/LoginWall';
import { Content as TermsContent } from '../content/legal/terms.md';
import '../styles/analyser.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
---

<Base title={title} description={description} noindex={noindex}>
  <Header />
  {/* "sticky" slot: a page may pin one slim bar here, between the header and the
      content (N1: the analyser's sticky verdict bar). Empty on every other page. */}
  <slot name="sticky" />
  <main class="page-wrap">
    <slot />
  </main>
  <Footer />
  <TabBar />
  {/* Terms text for the login wall — server-rendered once, cloned by the modal. */}
  <template id="legal-terms"><TermsContent /></template>
  <LoginWall client:idle />
</Base>
