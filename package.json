{
  "name": "gil-bricks",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/web",
    "dev": "npm run dev -w packages/web",
    "test": "npm test -w packages/core && npm test -w packages/web",
    "typecheck": "npm run typecheck -w packages/web && npm run typecheck -w packages/core"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "fsevents": true
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
