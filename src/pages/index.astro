---
import Base from '../layouts/Base.astro';
import GlassCard from '../components/GlassCard.astro';
import Button from '../components/Button.astro';
import { siteConfig } from '../site.config';
---

<Base title={`${siteConfig.siteName} — coming soon`}>
  <main>
    <GlassCard class="holding-card">
      <h1>{siteConfig.siteName}</h1>
      <p class="tagline">{siteConfig.tagline}</p>
      <Button variant="primary" href={siteConfig.socials.instagram}>Follow the build</Button>
    </GlassCard>
  </main>
</Base>

<style>
  main {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-5);
  }

  main :global(.holding-card) {
    max-width: 34rem;
    text-align: center;
  }

  h1 {
    font-size: clamp(1.75rem, 5vw, var(--text-3xl));
    font-weight: 800;
    letter-spacing: 0.01em;
    overflow-wrap: break-word;
  }

  .tagline {
    margin: var(--space-4) 0 var(--space-6);
    color: var(--text-dim);
  }
</style>
