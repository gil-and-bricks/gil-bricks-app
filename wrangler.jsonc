{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gil-bricks-app",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only auth/API paths hit the Worker — every page stays a static asset.
    "run_worker_first": ["/auth/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gil-bricks-db",
      "database_id": "d309be4b-5c14-4814-be70-82c62de75713"
    }
  ]
}
